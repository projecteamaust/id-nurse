# Copy this file to backend/.env and fill in your own values.
# .env is in .gitignore: never commit it and never put real values in this example file.

# Database. Local demo (no install needed): a SQLite file next to this file.
DATABASE_URL=sqlite:///id_nurse.db
# PostgreSQL (the real database, created with schema.sql):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/id_nurse

# Secret used to sign login tokens (JWT). Use a long random value, for example the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_JWT=change-me

# How long a login token is valid, in hours.
JWT_HOURS=8

# Most units of one item in one order (the app shows the same limit).
MAX_QTY_PER_ITEM=30

# Robot arm: mock = the built-in simulator, real = the Arduino over USB Serial.
ARM_MODE=mock
SERIAL_PORT=COM3
# Seconds the simulator waits for each move (0 = instant).
ARM_SIM_STEP_SECONDS=0.25

# Password for the seed supervisor account (employee 31082). Only read by: python -m app.seed
SEED_SUPERVISOR_PASSWORD=
